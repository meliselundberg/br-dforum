:root {
  --bg: #111;
  --panel: #1c1c1c;
  --panel2: #252525;
  --line: #3a3a3a;
  --text: #e8e8e8;
  --muted: #a8a8a8;
  --red: #9d2119;
  --yellow: #e3b340;
  --link: #f3cf71;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: Arial, Helvetica, sans-serif;
  font-size: 16px;
}

header {
  background: #080808;
  border-bottom: 4px solid var(--red);
  padding: 18px 14px;
}

.top {
  max-width: 1100px;
  margin: 0 auto;
}

h1 {
  margin: 0;
  font-size: 34px;
  color: var(--yellow);
  letter-spacing: 1px;
}

.subtitle {
  margin-top: 6px;
  color: var(--muted);
  font-size: 14px;
}

.wrap {
  max-width: 1100px;
  margin: 18px auto;
  padding: 0 12px;
  display: grid;
  grid-template-columns: 1fr 280px;
  gap: 16px;
}

@media (max-width: 800px) {
  .wrap {
    grid-template-columns: 1fr;
  }
}

.box {
  background: var(--panel);
  border: 1px solid var(--line);
}

.box-title {
  background: var(--red);
  color: white;
  padding: 10px 12px;
  font-weight: bold;
  text-transform: uppercase;
  letter-spacing: .5px;
}

.forum-row {
  display: grid;
  grid-template-columns: 48px 1fr 90px 150px;
  gap: 10px;
  padding: 14px 12px;
  border-top: 1px solid var(--line);
  align-items: center;
  cursor: pointer;
}

.forum-row:first-of-type {
  border-top: none;
}

.forum-row:hover {
  background: var(--panel2);
}

.icon {
  width: 38px;
  height: 38px;
  border-radius: 6px;
  background: #333;
  display: grid;
  place-items: center;
  font-size: 22px;
}

.secret-icon {
  cursor: help;
}

.secret-icon:hover {
  outline: 2px solid var(--yellow);
}

.thread-title {
  color: var(--link);
  font-weight: bold;
  margin-bottom: 0;
}

.stat,
.latest {
  color: var(--muted);
  font-size: 13px;
}

.latest b {
  color: var(--text);
}

@media (max-width: 700px) {
  .forum-row {
    grid-template-columns: 42px 1fr;
  }

  .stat,
  .latest {
    display: none;
  }
}

.side-content {
  padding: 12px;
  color: var(--muted);
  line-height: 1.45;
  font-size: 14px;
}

.pill {
  display: inline-block;
  background: #333;
  border: 1px solid var(--line);
  padding: 4px 7px;
  margin: 3px 2px;
  border-radius: 999px;
  color: var(--text);
  font-size: 12px;
}

.thread-view {
  display: none;
}

.back {
  display: inline-block;
  margin-bottom: 12px;
  color: var(--link);
  cursor: pointer;
  font-weight: bold;
}

.post {
  background: var(--panel);
  border: 1px solid var(--line);
  margin-bottom: 12px;
  display: grid;
  grid-template-columns: 190px 1fr;
}

@media (max-width: 700px) {
  .post {
    grid-template-columns: 1fr;
  }
}

.user {
  background: #171717;
  border-right: 1px solid var(--line);
  padding: 12px;
  text-align: center;
  min-width: 0;
  overflow: hidden;
}

@media (max-width: 700px) {
  .user {
    border-right: none;
    border-bottom: 1px solid var(--line);
    text-align: left;
    display: flex;
    align-items: center;
    gap: 10px;
  }
}

.avatar {
  width: 72px;
  height: 72px;
  border-radius: 4px;
  object-fit: cover;
  background: #000;
  border: 1px solid #dcdcdc;
  margin-bottom: 8px;
}

@media (max-width: 700px) {
  .avatar {
    width: 44px;
    height: 44px;
    margin-bottom: 0;
  }
}

.username {
  color: var(--yellow);
  font-weight: bold;
  margin-bottom: 4px;
  font-size: 15px;
  line-height: 1.15;
  overflow-wrap: anywhere;
  word-break: break-word;
}

.role {
  color: var(--muted);
  font-size: 12px;
}

.post-main {
  padding: 12px 14px;
  min-width: 0;
}

.post-time {
  color: var(--muted);
  font-size: 13px;
  padding-bottom: 8px;
  border-bottom: 1px dashed var(--line);
  margin-bottom: 10px;
}

.post-text {
  line-height: 1.5;
  overflow-wrap: anywhere;
}

.locked-note {
  background: #2a1d1d;
  border: 1px solid var(--red);
  color: #ffd7d7;
  padding: 10px;
  margin-top: 12px;
  font-size: 14px;
}

.login-button {
  width: 100%;
  background: var(--yellow);
  color: #111;
  border: none;
  padding: 10px 12px;
  font-weight: bold;
  cursor: pointer;
  margin-top: 12px;
}

.login-button:hover {
  background: #ffd76b;
}

.popup-backdrop {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.75);
  z-index: 999;
  padding: 20px;
}

.popup {
  max-width: 520px;
  margin: 10vh auto;
  background: #1c1c1c;
  color: var(--text);
  border: 2px solid var(--yellow);
  box-shadow: 0 0 30px rgba(0, 0, 0, .7);
}

.popup-title {
  background: var(--red);
  color: white;
  padding: 12px;
  font-weight: bold;
  text-transform: uppercase;
}

.popup-content {
  padding: 16px;
  line-height: 1.5;
}

.popup input {
  width: 100%;
  padding: 10px;
  margin: 6px 0 12px;
  background: #111;
  color: var(--text);
  border: 1px solid var(--line);
}

.popup button {
  background: var(--yellow);
  border: none;
  padding: 10px 14px;
  font-weight: bold;
  cursor: pointer;
  margin-right: 6px;
  margin-top: 6px;
}

.order-box {
  background: #111;
  border: 1px solid var(--line);
  padding: 12px;
  white-space: pre-line;
  font-family: Georgia, serif;
  font-size: 18px;
}

.error {
  color: #ffb4b4;
  margin-top: 10px;
}

a {
  color: var(--link);
}
